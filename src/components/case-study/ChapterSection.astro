---
import type { Chapter, ZoomIn, DiagramDef } from '../../data/case-studies/apartment-scout';
import DiagramFrame from './DiagramFrame.astro';
import ZoomTrigger from './ZoomTrigger.astro';

interface Props {
  chapter: Chapter;
  zoomIns: ZoomIn[];
  diagrams: Record<string, DiagramDef>;
}

const { chapter, zoomIns, diagrams } = Astro.props;
const chapterZooms = chapter.zoomIds
  .map((id) => zoomIns.find((z) => z.id === id))
  .filter((z): z is ZoomIn => Boolean(z));
---

<section
  id={`chapter-${chapter.id}`}
  class="py-20 md:py-28 grid md:grid-cols-[1fr_2fr] gap-10 md:gap-16 md:ml-16"
  data-chapter-section
  data-chapter-id={chapter.id}
  data-chapter-eyebrow={chapter.eyebrow}
>
  <div>
    <p
      class="section-label"
      data-title-scale
      style="font-size: 0.95rem; font-weight: 700; letter-spacing: 0.08em; color: var(--color-text)"
    >
      {chapter.eyebrow}
    </p>
  </div>
  <div data-reveal>
    <h2 class="text-3xl md:text-4xl font-bold mb-3" style="font-family: var(--font-heading)">
      {chapter.heading}
    </h2>
    <p class="text-lg md:text-xl mb-6" style="color: var(--color-accent)">{chapter.summary}</p>

    <div class="space-y-4 text-base leading-relaxed" style="color: var(--color-text)">
      {chapter.body.split('\n\n').map((block) =>
        block.trimStart().startsWith('- ') ? (
          <ul class="space-y-2 list-disc pl-5">
            {block.split('\n').map((line) => (
              <li>{line.replace(/^- /, '')}</li>
            ))}
          </ul>
        ) : (
          <p>{block}</p>
        )
      )}
    </div>

    {chapter.diagramId && diagrams[chapter.diagramId] && (
      <DiagramFrame diagram={diagrams[chapter.diagramId]} />
    )}

    {chapter.screenshots && chapter.screenshots.length > 0 && (
      <div class="my-8 space-y-6">
        <p class="section-label">Real screenshots, taken directly from the app</p>
        {chapter.screenshots.map((shot) => (
          <figure>
            <img
              src={shot.src}
              alt={shot.caption}
              loading="lazy"
              class="w-full rounded-lg border"
              style="border-color: var(--color-border)"
            />
            <figcaption class="mt-2 text-sm" style="color: var(--color-muted)">{shot.caption}</figcaption>
          </figure>
        ))}
      </div>
    )}

    {chapterZooms.length > 0 && (
      <div class="mt-8 pt-6 border-t" style="border-color: var(--color-border)">
        <p class="section-label mb-3">Go deeper</p>
        <ul class="space-y-2">
          {chapterZooms.map((zoom) => (
            <li>
              <ZoomTrigger id={zoom.id} label={zoom.title} />
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>
</section>

<script>
  function initTitleScale() {
    const titles = Array.from(document.querySelectorAll<HTMLElement>('[data-title-scale]'));
    if (titles.length === 0) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const MAX_SCALE = 2.4;
    let ticking = false;

    function update() {
      ticking = false;
      const vh = window.innerHeight;
      const settlePoint = vh * 0.4;
      titles.forEach((el) => {
        const rect = el.getBoundingClientRect();
        const raw = (rect.top - settlePoint) / (vh - settlePoint);
        const progress = Math.min(1, Math.max(0, raw));
        const scale = 1 + progress * (MAX_SCALE - 1);
        el.style.transform = `scale(${scale})`;
      });
    }

    function onScroll() {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(update);
      }
    }

    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initTitleScale);
  } else {
    initTitleScale();
  }
</script>
